exports[`optimized negative zero initializer 1`] = `
{
  "optimized": "for i = -0, 0 do
	print(1 / i)
end
return nil
",
  "unoptimized": "do
	local i = -0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i <= 0) then
			break
		end
		print(1 / i)
	end
end
return nil
",
}
`;

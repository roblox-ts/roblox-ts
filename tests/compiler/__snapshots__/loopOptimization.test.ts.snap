// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`fallback ambient constant bound 1`] = `
"do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < limit) then
			break
		end
		print(i)
	end
end
return nil
"
`;


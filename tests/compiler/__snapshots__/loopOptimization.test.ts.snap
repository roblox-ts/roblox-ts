// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`fallback arithmetic bound 1`] = `
"do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < 1 + 2) then
			break
		end
		print(i)
	end
end
return nil
"
`;

exports[`fallback changing array-size bound 1`] = `
"local values = { 1, 2, 3, 4 }
do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < #values) then
			break
		end
		values[#values] = nil
	end
end
return nil
"
`;

exports[`fallback constant identifier bound 1`] = `
"local limit = 3
do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < limit) then
			break
		end
		print(i)
	end
end
return nil
"
`;

exports[`fallback destructuring write to induction variable 1`] = `
"do
	local _i = 0
	local _shouldIncrement = false
	while true do
		local i = _i
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < 3) then
			break
		end
		i = 5
		_i = i
	end
end
return nil
"
`;

exports[`fallback different condition variable 1`] = `
"local condition = 2
do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (condition < 3) then
			break
		end
		condition += 1
		print(i)
	end
end
return nil
"
`;

exports[`fallback different decrement target 1`] = `
"local remaining = 3
do
	local i = 3
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			remaining -= 1
		else
			_shouldIncrement = true
		end
		if not (i > 0) then
			break
		end
		if remaining == 1 then
			break
		end
		print(i)
	end
end
return nil
"
`;

exports[`fallback effectful bound with a literal return type 1`] = `
"local function limit()
	print("limit")
	return 2
end
do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < limit()) then
			break
		end
		print(i)
	end
end
return nil
"
`;


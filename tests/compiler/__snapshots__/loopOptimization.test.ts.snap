exports[`fallback parameter bound 1`] = `
"local function run(limit)
	if limit == nil then
		limit = 3
	end
	do
		local i = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				i += 1
			else
				_shouldIncrement = true
			end
			if not (i < limit) then
				break
			end
			limit -= 1
		end
	end
end
run()
return nil
"
`;

exports[`fallback tuple iterator assignment target 1`] = `
"local pair
local _iterator = iterator
while true do
	local _v = { _iterator() }
	if _v[1] == nil then
		break
	end
	pair = _v
	print(pair[2])
end
return nil
"
`;


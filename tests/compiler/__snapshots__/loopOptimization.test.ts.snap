exports[`optimized ascending exclusive bound 1`] = `
{
  "optimized": "for i = 0, 2 do
	print(i)
end
return nil
",
  "unoptimized": "do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < 3) then
			break
		end
		print(i)
	end
end
return nil
",
}
`;

exports[`optimized ascending inclusive bound with a step 1`] = `
{
  "optimized": "for i = 0, 4, 2 do
	print(i)
end
return nil
",
  "unoptimized": "do
	local i = 0
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i += 2
		else
			_shouldIncrement = true
		end
		if not (i <= 4) then
			break
		end
		print(i)
	end
end
return nil
",
}
`;

exports[`optimized descending exclusive bound 1`] = `
{
  "optimized": "for i = 3, 1, -1 do
	print(i)
end
return nil
",
  "unoptimized": "do
	local i = 3
	local _shouldIncrement = false
	while true do
		if _shouldIncrement then
			i -= 1
		else
			_shouldIncrement = true
		end
		if not (i > 0) then
			break
		end
		print(i)
	end
end
return nil
",
}
`;

exports[`optimized descending inclusive bound with a step 1`] = `
{
  "optimized": "for i = 4, 0, -2 do
	print(i)
end
return nil
",
  "unoptimized": "do
	local i = 4
	local _shouldIncrement = false

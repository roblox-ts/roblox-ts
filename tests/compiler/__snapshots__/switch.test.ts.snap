// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`avoids continue flags for loops inside a case 1`] = `
"for _, value in { 1, 2 } do
	repeat
		if value == 1 then
			for _1, inner in { 1, 2 } do
				if inner == 1 then
					continue
				end
				print(inner)
			end
			break
		end
	until true
	print(value)
end
return nil
"
`;

exports[`avoids continue flags for switch statements without a continue 1`] = `
"for _, value in { 1, 2 } do
	repeat
		if value == 1 then
			print("a")
			break
		end
		print("b")
	until true
	print(value)
end
return nil
"
`;

exports[`avoids continue flags for try statements inside a case 1`] = `
"local TS = _G[script]
for _, value in { 1, 2 } do
	repeat
		local _fallthrough = false
		if value == 2 then
			local _exitType, _returns = TS.try(function()
				return TS.TRY_CONTINUE
			end, nil, function()
				print("c")
			end)
			if _exitType then
				continue
			end
		end
	until true
	print(value)
end
return nil
"
`;

exports[`avoids operand captures for boolean cases with a mutable local 1`] = `
"local value = true
repeat
	local _fallthrough = false
	if value == true then
		value = false
		_fallthrough = true
	end
	if _fallthrough or value == false then
		print(value)
	end
until true
return nil
"
`;

exports[`avoids operand captures for literal cases with a parameter 1`] = `
"local function handle(kind)
	repeat
		local _fallthrough = false
		if kind == "a" then
			return 1
		end
		if kind == "b" then
			_fallthrough = true
		end
		if _fallthrough or kind == "c" then
			return 2
		end
		return 0
	until true
end
return nil
"
`;

exports[`avoids operand captures for wrapped numeric and template literal cases 1`] = `
"local function handle(value)
	repeat
		if value == 1 then
			return 1
		end
		local _caseValue = \`two\`
		if value == _caseValue then
			return 2
		end
	until true
end
return nil
"
`;

exports[`continues the enclosing loop from inside a switch for do-while loops 1`] = `
"local count = 0
repeat
	do
		count += 1
		local _continue = false
		repeat
			if count == 2 then
				_continue = true
				break
			end
		until true
		if _continue then
			continue
		end
		print(count)
	end
until not (count < 3)
return nil
"
`;

exports[`continues the enclosing loop from inside a switch for fallthrough clauses 1`] = `
"for _, value in { 1, 2, 3 } do
	local _continue = false
	repeat
		local _fallthrough = false
		if value == 1 then
			_fallthrough = true
		end
		if _fallthrough or value == 2 then
			if value == 2 then
				_continue = true
				break
			end
			print("one or two")
			break
		end
		print("other")
	until true
	if _continue then
		continue
	end
	print(value)
end
return nil
"
`;


exports[`continues the enclosing loop from inside a switch for nested switch statements 1`] = `
"for _, value in { 1, 2 } do
	local _continue = false
	repeat
		local _fallthrough = false
		if value == 2 then
			local _continue_1 = false
			repeat
				if value == 2 then
					_continue_1 = true
					break
				end
			until true
			if _continue_1 then
				_continue = true
				break
			end
			print("outer")
		end
	until true
	if _continue then
		continue
	end
	print(value)
end
return nil
"
`;

exports[`continues the enclosing loop from inside a switch for unoptimized for loops 1`] = `
"do
	local _i = 0
	local _shouldIncrement = false
	while true do
		local i = _i
		if _shouldIncrement then
			i += 1
		else
			_shouldIncrement = true
		end
		if not (i < 6) then
			break
		end
		local _continue = false
		repeat
			if i == 1 then
				_continue = true
				break
			end
			if i == 3 then
				i += 1
				break
			end
		until true
		if _continue then
			_i = i
			continue
		end
		print(i)
		_i = i
	end
end
return nil
"
`;

exports[`continues the enclosing loop from inside a switch for while loops 1`] = `
"local count = 0
while count < 3 do
	count += 1
	local _continue = false
	repeat
		if count == 2 then
			_continue = true
			break
		end
	until true
	if _continue then
		continue
	end
	print(count)
end
return nil
"
`;

exports[`emits enum case values directly 1`] = `
"local Kind = {
	A = "A",
	B = "B",
}
local function handle(value, enumAlias)
	local _exp = value
	repeat
		if _exp == "missing" then
			break
		end
		if _exp == Kind.A then
			break
		end
		if _exp == Kind.B then
			break
		end
		local _caseValue = enumAlias.B
		if _exp == _caseValue then
			break
		end
	until true
end
return nil
"
`;

exports[`retains operand captures for case assignments 1`] = `
"local function handle(value)
	local _exp = value
	repeat
		value = 2
		local _caseValue = value
		if _exp == _caseValue then
			return "two"
		end
		return "original"
	until true
end
return nil
"
`;

exports[`retains operand captures for case calls that mutate the parameter 1`] = `
"local function handle(value)
	local function change()
		value = 2
		return 0
	end
	local _exp = value
	repeat
		local _caseValue = change()
		if _exp == _caseValue then
			return "zero"
		end
		if _exp == 2 then
			return "two"
		end
		return "original"
	until true
end
return nil
"
`;

exports[`retains operand captures for hoisted declarations that shadow the operand 1`] = `
"local function handle(value)
	local _exp = value
	repeat
		local _fallthrough = false
		local value
		if _exp == "a" then
			value = "inner"
			_fallthrough = true
		end
		if _fallthrough or _exp == "b" then
			return value
		end
	until true
end
return nil
"
`;

exports[`retains operand captures for property operands with literal cases 1`] = `
"local function handle(value)
	local _exp = value.kind
	repeat
		if _exp == "a" then
			return 1
		end
		if _exp == "b" then
			return 2
		end
	until true
end
return nil
"
`;

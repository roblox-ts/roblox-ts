exports[`keeps string indexing prerequisites inside optional chains 1`] = `
"local function read(value)
	local _result = value
	if _result ~= nil then
		local _arg0 = index()
		_result = if _arg0 >= 0 and _arg0 % 1 == 0 and _arg0 < #_result then string.sub(_result, _arg0 + 1, _arg0 + 1) else nil
	end
	return _result
end
return {
	read = read,
}
"
`;

exports[`preserves effects when an indexed value is discarded 1`] = `
"local _exp = value()
local _arg0 = index()
local _ = if _arg0 >= 0 and _arg0 % 1 == 0 and _arg0 < #_exp then string.sub(_exp, _arg0 + 1, _arg0 + 1) else nil
return nil
"
`;

exports[`reuses one string iterator for bindings and rest 1`] = `
"local _binding = "abc"
local _matcher = string.gmatch(_binding, utf8.charpattern)
local first = _matcher()
_matcher()
local third = _matcher()
if third == nil then
	third = "fallback"
end
local _rest = {}
for _char in _matcher do
	table.insert(_rest, _char)
end
local rest = _rest
return {
	first = first,
	third = third,
	rest = rest,
}
"
`;

exports[`uses byte indexing for numeric object destructuring keys 1`] = `
"local _binding = value
local first = if 0 < #_binding then string.sub(_binding, 1, 1) else nil
local _index = tonumber("1")
local second = if _index ~= nil and _index >= 0 and _index % 1 == 0 and _index < #_binding then string.sub(_binding, _index + 1, _index + 1) else nil
local missing = if 5 < #_binding then string.sub(_binding, 6, 6) else nil
if missing == nil then
	missing = "fallback"
end
return {
	first = first,
	second = second,
	missing = missing,
}
"
`;

exports[`uses byte offsets for literal indices 1`] = `
"local function read(value)
	return if 0 < #value then string.sub(value, 1, 1) else nil
end
local function readOffset(value)
	return if 10 < #value then string.sub(value, 11, 11) else nil
end
return {
	read = read,
	readOffset = readOffset,
}
"
`;

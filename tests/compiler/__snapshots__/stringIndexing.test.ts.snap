// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`captures a receiver before an index call rebinds it 1`] = `
"local value = "abc"
local function index()
	value = "xyz"
	return 0
end
local _exp = value
local _arg0 = index()
local byte = if _arg0 >= 0 and _arg0 % 1 == 0 and _arg0 < #_exp then string.sub(_exp, _arg0 + 1, _arg0 + 1) else nil
return {
	byte = byte,
}
"
`;

exports[`checks dynamic byte indices without capturing parameters 1`] = `
"local function read(value, index)
	return if index >= 0 and index % 1 == 0 and index < #value then string.sub(value, index + 1, index + 1) else nil
end
return {
	read = read,
}
"
`;

exports[`converts numeric string keys 1`] = `
"local function read(value, index)
	local _index = tonumber(index)
	return if _index ~= nil and _index >= 0 and _index % 1 == 0 and _index < #value then string.sub(value, _index + 1, _index + 1) else nil
end
local first = if 0 < #"abc" then string.sub("abc", 1, 1) else nil
return {
	read = read,
	first = first,
}
"
`;

exports[`evaluates a receiver before index prerequisites 1`] = `

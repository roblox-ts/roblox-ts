// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`captures iterators before nested defaults can reassign them 1`] = `
"local _binding = iterator
local _value = { _binding() }
local _done = _value[1] == nil
local _binding_1 = if _done then nil else _value
local first = _binding_1[1]
local value = _binding_1[2]
if value == nil then
	iterator = replacement
	local _ = iterator
	value = 99
end
local _value_1
if not _done then
	local _value_2 = { _binding() }
	_done = _value_2[1] == nil
	_value_1 = if _done then nil else _value_2
end
local second = _value_1
local _rest = {}
if not _done then
	local _length = 0
	while true do
		local _value_2 = { _binding() }
		if _value_2[1] == nil then
			break
		end
		_length += 1
		_rest[_length] = _value_2
	end
end
local rest = _rest
print(first, value, second, rest)
return nil
"
`;

exports[`captures reassignable iterators before preceding bindings 1`] = `
"local calls = 0
local iterator
iterator = (function()
	calls += 1
	iterator = (function()
		error("replacement iterator")
	end)
	return if calls <= 3 then calls else nil
end)
local _binding = iterator
local _value = _binding()
local _done = _value == nil
local first = _value
local _value_1
if not _done then
	local _value_2 = _binding()
	_done = _value_2 == nil
	_value_1 = _value_2
end
local second = _value_1
local _rest = {}
if not _done then
	local _length = 0
	while true do
		local _value_2 = _binding()
		if _value_2 == nil then
			break
		end
		_length += 1
		_rest[_length] = _value_2
	end
end
local rest = _rest
print(first, second, rest)
return nil
"
`;


exports[`preserves rest destructuring emit for map prefix and rest 1`] = `
"local function read(source)
	local _key
	local _value
	_key, _value = next(source, _key)
	local _done = _key == nil
	local first = if _done then nil else { _key, _value }
	if not _done then
		_key = next(source, _key)
		_done = _key == nil
	end
	local _rest = {}
	if not _done then
		local _length = 0
		while true do
			local _value_1
			_key, _value_1 = next(source, _key)
			if _key == nil then
				break
			end
			_length += 1
			_rest[_length] = { _key, _value_1 }
		end
	end
	local rest = _rest
	return rest
end
return nil
"
`;


exports[`preserves rest destructuring emit for computed object keys 1`] = `
"local key = "a"
local source = {
	b = 2,
}
local function fallback()
	key = "b"
	return 10
end
local _key = key
local value = source[_key]
if value == nil then
	value = fallback()
end
local _rest = {}
for _key_1, _value in source do
	if _key_1 ~= _key then
		_rest[_key_1] = _value
	end
end
local rest = _rest
print(value, rest)
return nil
"
`;

exports[`preserves rest destructuring emit for generator completion 1`] = `
"local TS = _G[script]
local function values()
	return TS.generator(function()
		coroutine.yield(1)
		return 99
	end)
end
local _binding = values()
local _next = _binding.next
local _result = _next()
local _done = _result.done
local first = if _done then nil else _result.value
local _value
if not _done then
	local _result_1 = _next()
	_done = _result_1.done
	_value = if _done then nil else _result_1.value
end
local second = _value
if second == nil then
	second = 7
end
local _rest = {}
if not _done then
	local _length = 0
	while true do
		local _result_1 = _next()
		if _result_1.done then
			break
		end
		_length += 1
		_rest[_length] = _result_1.value
	end
end
local rest = _rest
print(first, second, rest)
return nil
"
`;


exports[`preserves rest destructuring emit for object rest exclusions 1`] = `
"local function read(source)
	local _rest = {}
	for _key, _value in source do
		_rest[_key] = _value
	end
	local all = _rest
	local a = source.a
	local _rest_1 = {}
	for _key, _value in source do
		if _key ~= "a" then
			_rest_1[_key] = _value
		end
	end
	local tail = _rest_1
	local first = source.a
	local second = source.b
	local _rest_2 = {}
	local _extracted = {
		a = true,
		b = true,
	}
	for _key, _value in source do
		if not _extracted[_key] then
			_rest_2[_key] = _value
		end
	end
	local last = _rest_2
	return { all, tail, last }
end
return nil
"
`;


	if _key ~= "a" then
		_rest[_key] = _value
	end
end
local rest = _rest
print(first, rest)
return nil
"
`;

exports[`preserves rest destructuring emit for string rest 1`] = `
"local function read(source)
	local _matcher = string.gmatch(source, utf8.charpattern)
	local first = _matcher()
	_matcher()
	local _rest = {}
	for _char in _matcher do
		table.insert(_rest, _char)
	end
	local rest = _rest
	return rest
end
return nil
"
`;

exports[`preserves rest destructuring emit for tuple iterator loop rest 1`] = `
"local first
local rest
local _iterFunc = string.gmatch("ab", "(.)(.)")
while true do
	local _binding = { _iterFunc() }
	if _binding[1] == nil then
		break
	end
	first = _binding[1]
	rest = table.move(_binding, 2, #_binding, 1, {})
	print(first, rest)
end
return nil
"
`;


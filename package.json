{
	"name": "roblox-ts",
	"version": "3.0.0",
	"description": "A TypeScript-to-Luau Compiler for Roblox",
	"main": "out/CLI/index.js",
	"browser": "out/CLI/browser.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/roblox-ts/roblox-ts.git"
	},
	"bin": {
		"rbxtsc": "out/CLI/cli.js"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tspc -b",
		"build-watch": "tspc -b -w",
		"eslint": "eslint --max-warnings 0",
		"devlink": "npm run build && cd devlink && npm link",
		"update-test-types": "cd tests && npm install github:roblox-ts/compiler-types @rbxts/types@latest && npm install",
		"test": "npm run build && npm run test-compile && npm run test-rojo && npm run test-run",
		"test-compile": "jest --coverage",
		"test-rojo": "rojo build tests -o ./tests/test.rbxl",
		"test-run": "lune run ./tests/runTestsWithLune.luau ./tests/test.rbxl",
		"test-roblox": "npm run build && npm run test-compile && npm run test-rojo && npm run run-in-roblox",
		"run-in-roblox": "run-in-roblox --place ./tests/test.rbxl --script ./tests/out/main.server.luau"
	},
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@jridgewell/gen-mapping": "^0.3.13",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@roblox-ts/luau-ast": "git+https://github.com/christopher-buss/luau-ast.git#8e2c0e9f75d4b01262c1a511b93630f8edc97ca2",
		"@roblox-ts/path-translator": "=1.1.1",
		"@roblox-ts/rojo-resolver": "=1.2.1",
		"chokidar": "^4.0.3",
		"fs-extra": "^11.4.0",
		"kleur": "^4.1.5",
		"resolve": "^1.22.12",
		"typescript": "=5.9.3",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.5.0",
		"@types/prompts": "^2.4.9",
		"@types/resolve": "^1.20.6",
		"@types/ts-expose-internals": "npm:@roblox-ts/ts-expose-internals@=5.9.3",
		"@types/yargs": "^17.0.35",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.6",
		"ts-patch": "^3.3.0",
		"typescript-eslint": "^8.70.0",
		"typescript-transform-paths": "^4.0.0",
		"@types/jest": "^30.0.0",
		"jest": "^30.5.1",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2"
	},
	"files": [
		"out",
		"include",
		"CHANGELOG.md",
		"!**/*.js.map",
		"!**/*.tsbuildinfo"
	]
}
